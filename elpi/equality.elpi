% The interface equality backends
accumulate syntax.
kind eq_ctx type.

% equal and assume_eq should only be called on variables introduced by add_var
pred equal     i:eq_ctx, i:tm, i:tm.                     % X = Y holds
pred assume_eq i:eq_ctx, i:tm, i:tm, i:(eq_ctx -> prop). % continue under X = Y
pred add_var   i:eq_ctx, i:tm, i:(eq_ctx -> prop).       % continue with a new variable
