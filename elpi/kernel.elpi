% The rules, parametric in an equality backend (see equality.elpi).
accumulate equality.

pred of i:tm, o:ty. % presheaf context
pred known i:name, o:fm.

pred equals i:eq_ctx, i:list tm, i:list tm.
equals _ [] [].
equals E [X|Xs] [Y|Ys] :- equal E X Y, equals E Xs Ys.

pred of_ty i:eq_ctx, i:tm, i:ty. % X : T, up to equality
of_ty E refl (eq A B) :- equal E A B.
of_ty E X (s N Ys)    :- of X (s N Xs), equals E Xs Ys.

pred assume i:eq_ctx, i:tm, i:ty, i:(eq_ctx -> prop). % continue under X : T
assume E _ (eq A B) K :- assume_eq E A B K.
assume E X (s N Xs) K :- of X (s N Xs) => add_var E X K.

% The focused reading (LJF): all and imp are negative, ex and tt positive, and
% sorts are positive atoms. A rule is a bipole, and apply runs it in one go:
%   apply       decide on a rule, focusing on the left (term match, then premise proofs)
%   unpack      end of the focus: open the rule's existential conclusion on the left
%   done        decide on the right; its witnesses are the right focus
%   intro       eigenvariables of the right asynchronous phase (root layer)
%   intro_rule  local rule hypotheses of the right asynchronous phase (-D SECOND)
% of_ty is the initial rule (and =R, for refl); assume_eq is =L.

% 1. Right async (R↑): introduce the root layer (and premises, if second-order)
pred prove i:eq_ctx, i:pf, i:fm.
prove E (intro P) (all T F) :- pi x\ assume E x T (d\ prove d (P x) (F x)).
:if "SECOND" prove E (intro_rule P) (imp N F) :- pi n\ known n N => prove E (P n) F.
prove E P (ex T F)          :- solve E P (ex T F).
prove E P tt                :- solve E P tt.

% 2. Neutral (Decide): apply a rule bipole on the left, or close the goal on the right
pred solve i:eq_ctx, i:pf, i:fm.
solve E (apply N Xs Ps P) G :- known N F, apply_rule E F Xs Ps P G.
solve E (done Ws) G         :- witness E Ws G.

% 3. Left focus (L↓) + Left async (L↑): match root, prove premises, unpack conclusion
pred apply_rule i:eq_ctx, i:fm, i:list tm, i:list pf, i:pf, i:fm.
apply_rule E (all T F) [X|Xs] Ps     P          G :- of_ty E X T, apply_rule E (F X) Xs Ps P G.
apply_rule E (imp N F) []     [Q|Qs] P          G :- prove E Q N, apply_rule E F [] Qs P G.
apply_rule E (ex T F)  []     []     (unpack P) G :- pi x\ assume E x T (d\ apply_rule d (F x) [] [] (P x) G).
apply_rule E tt        []     []     P          G :- solve E P G.

% 4. Right focus (R↓): supply witnesses for the positive goal
pred witness i:eq_ctx, i:list tm, i:fm.
witness E [X|Xs] (ex T F) :- of_ty E X T, witness E Xs (F X).
witness _ []     tt.

% well-formed statements
pred wfdeps i:list tm, i:list string.
wfdeps [] [].
wfdeps [X|Xs] [D|Ds] :- of X (s D _), wfdeps Xs Ds.

pred wf_ty i:eq_ctx, i:ty.
wf_ty E (eq A B) :- of B T, of_ty E A T.
wf_ty _ (s N Xs) :- sort N Ds, wfdeps Xs Ds.

pred wf_concl i:eq_ctx, i:fm. % A positive conclusion layer
wf_concl E (ex T F)  :- wf_ty E T, pi x\ assume E x T (d\ wf_concl d (F x)).
wf_concl _ tt.

pred wf_fo i:eq_ctx, i:fm. % First order rule / premise / theorem
wf_fo E (all T F) :- wf_ty E T, pi x\ assume E x T (d\ wf_fo d (F x)).
wf_fo E F :- wf_concl E F.

pred wf_so i:eq_ctx, i:fm. % Second order rule
wf_so E (all T F) :- wf_ty E T, pi x\ assume E x T (d\ wf_so d (F x)).
wf_so E F :- wf_prems E F.

pred wf_prems i:eq_ctx, i:fm. % disallow implication nesting to the left
wf_prems E (imp N F) :- wf_fo E N, wf_prems E F.
wf_prems E F :-  wf_concl E F.

pred wf_thm i:eq_ctx, i:fm.
:if "SECOND" wf_thm E F :- wf_so E F.
wf_thm E F :- wf_fo E F.

% scripts, from the initial state E
pred script i:eq_ctx, i:list item.
script _ [].
script E [axiom N F|L] :- wf_so E F, known N F => script E L.
script E [thm N F P|L] :- wf_thm E F, prove E P F, known N F => script E L.
script E [def N F|L]   :- wf_so E F,
  known N F => (pi I R\ known (inv N I) R :- elim F I R) => script E L.

pred elim i:fm, i:int, o:fm.                 % the rule Γ, C, P_I |- Q_I
elim (all T F) I (all T E) :- pi x\ elim (F x) I (E x).
elim (imp N F) 0 E         :- concl F C, weaken C N E.
elim (imp _ F) I E         :- I > 0, J is I - 1, elim F J E.

pred concl i:fm, o:fm.
concl (imp _ F) C :- concl F C.
concl (ex T F) (ex T F).
concl tt tt.

pred weaken i:fm, i:fm, o:fm.
weaken (ex T C) N (all T E) :- pi x\ weaken (C x) N (E x).
weaken tt N N.
