% Equality backend: union-find in the context. Equations link representatives,
% so every variable has at most one link; find needs a cut to stop at the end.
accumulate equality.

type links eq_ctx.
pred link i:tm, o:tm.

pred find i:tm, o:tm.
find X R :- link X Y, !, find Y R.
find X X.

equal links X Y :- find X R, find Y R.

assume_eq links X Y K :- equal links X Y, !, K links.
assume_eq links X Y K :- find X A, find Y B, link A B => K links.

add_var links _ K :- K links.
