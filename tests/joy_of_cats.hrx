      "rocqProof": "Lemma Prop_11_18_3___retractions_are_pullback_stable_rule : forall (P A B C : Vertex)(p : Edge P A)(q : Edge P B)(f : Edge A C)(g : Edge B C)(isRetraction_2 : isRetraction f)(Pullback_2 : Pullback p q g f), isRetraction q.\nintros_sigma ().\ndestruct_sigma (@RetractionElim_rule A C f isRetraction_2) as s_f id_C Triangle_2 isId_2.\ndestruct_sigma (@Id_rule B) as id_B isId_3.\ndestruct_sigma (@Compose_rule B C A g s_f) as s_f_g Triangle_3.\ndestruct_sigma (@UnitR_rule B C g id_C isId_2) as Triangle_4.\ndestruct_sigma (@UnitL_rule B C id_B g isId_3) as Triangle_5.\ndestruct_sigma (@AssocR_rule B C A C g s_f f s_f_g id_C g Triangle_3 Triangle_2 Triangle_4) as Triangle_6.\ndestruct_sigma (@PullbackExists_rule P A B C B p q f g s_f_g id_B g Triangle_6 Triangle_5 Pullback_2) as x_s_f_g_id_B_ Triangle_7 Triangle_8.\ndestruct_sigma (@RetractionIntro_rule P B q x_s_f_g_id_B_ id_B Triangle_8 isId_3) as isRetraction_4.\nexact isRetraction_4.\nQed.\n",
