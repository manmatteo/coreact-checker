      "isRule": true,
      "isFirstOrder": true,
      "rocqProof": "Lemma Prop_11_18_2___regular_monos_are_pullback_stable_rule : forall (P A B C D : Vertex)(p : Edge P A)(q : Edge P B)(f : Edge A C)(g : Edge B C)(r s : Edge C D)(r_g s_g : Edge B D)(Triangle_2 : Triangle g r r_g)(Triangle_3 : Triangle g s s_g)(Equalizer_2 : Equalizer f r s)(Pullback_2 : Pullback p q g f), Equalizer q r_g s_g.\nintros_sigma ().\nassert (Hpremise1 : Σ (x_f__e : Edge P D)(Triangle_4 : Triangle q r_g x_f__e), Triangle q s_g x_f__e). {\n  intros_sigma ().\n  destruct_sigma (@PullbackCommute_rule P A B C p q f g Pullback_2) as f_p Triangle_6 Triangle_7.\n  destruct_sigma (@EqualizerFork_rule A C D f r s Equalizer_2) as r_f Triangle_8 Triangle_9.\n  destruct_sigma (@Compose_rule P A D p r_f) as r_f_p Triangle_10.\n  destruct_sigma (@AssocR_rule P A C D p f r f_p r_f r_f_p Triangle_6 Triangle_8 Triangle_10) as Triangle_11.\n  destruct_sigma (@AssocR_rule P A C D p f s f_p r_f r_f_p Triangle_6 Triangle_9 Triangle_10) as Triangle_12.\n  destruct_sigma (@AssocL_rule P B C D q g r f_p r_g r_f_p Triangle_7 Triangle_2 Triangle_11) as Triangle_13.\n  destruct_sigma (@AssocL_rule P B C D q g s f_p s_g r_f_p Triangle_7 Triangle_3 Triangle_12) as Triangle_14.\n  exact (r_f_p, Triangle_13, Triangle_14).\n}\nassert (Hpremise2 : forall (X : Vertex)(x : Edge X B)(w : Edge X D)(Triangle_4 : Triangle x r_g w)(Triangle_5 : Triangle x s_g w), Σ (x_x__e : Edge X P), Triangle x_x__e q x). {\n  intros_sigma ().\n  destruct_sigma (@Compose_rule X B C x g) as g_x Triangle_7.\n  destruct_sigma (@AssocR_rule X B C D x g r g_x r_g w Triangle_7 Triangle_2 Triangle_4) as Triangle_8.\n  destruct_sigma (@AssocR_rule X B C D x g s g_x s_g w Triangle_7 Triangle_3 Triangle_5) as Triangle_9.\n  destruct_sigma (@EqualizerExists_rule A C D X f r s g_x w Triangle_8 Triangle_9 Equalizer_2) as g_x_f Triangle_10.\n  destruct_sigma (@PullbackExists_rule P A B C X p q f g g_x_f x g_x Triangle_10 Triangle_7 Pullback_2) as x_g_x_f_x_ Triangle_11 Triangle_12.\n  exact (x_g_x_f_x_, Triangle_12).\n}\nassert (Hpremise3 : forall (X : Vertex)(u v : Edge X P)(x : Edge X B)(Triangle_4 : Triangle u q x)(Triangle_5 : Triangle v q x), u = v). {\n  intros_sigma ().\n  destruct_sigma (@Prop_7_59_2___equalizers_are_mono_rule A C D f r s Equalizer_2) as isMono_2.\n  destruct_sigma (@Prop_11_18_1___monos_are_pullback_stable_rule P A B C p q f g isMono_2 Pullback_2) as isMono_3.\n  destruct_sigma (@MonoElim_rule P B X q u v x Triangle_4 Triangle_5 isMono_3) as _.\n  exact eq_refl.\n}\ndestruct_sigma (@EqualizerIntro_rule P B D q r_g s_g Hpremise1 Hpremise2 Hpremise3) as Equalizer_4.\nexact Equalizer_4.\nQed.\n",
