      "rocqProof": "Lemma Prop_7_34_1___monos_compose_rule : forall (A B C : Vertex)(f : Edge A B)(g : Edge B C)(g_f : Edge A C)(Triangle_2 : Triangle f g g_f)(isMono_2 : isMono f)(isMono_3 : isMono g), isMono g_f.\nintros_sigma ().\nassert (Hpremise1 : forall (X : Vertex)(u v : Edge X A)(w : Edge X C)(Triangle_3 : Triangle u g_f w)(Triangle_4 : Triangle v g_f w), u = v). {\n  intros_sigma ().\n  destruct_sigma (@Compose_rule X A B u f) as f_u Triangle_5.\n  destruct_sigma (@Compose_rule X A B v f) as f_v Triangle_6.\n  destruct_sigma (@AssocR_rule X A B C u f g f_u g_f w Triangle_5 Triangle_2 Triangle_3) as Triangle_7.\n  destruct_sigma (@AssocR_rule X A B C v f g f_v g_f w Triangle_6 Triangle_2 Triangle_4) as Triangle_8.\n  destruct_sigma (@MonoElim_rule B C X g f_u f_v w Triangle_7 Triangle_8 isMono_3) as _.\n  destruct_sigma (@MonoElim_rule A B X f u v f_u Triangle_5 Triangle_6 isMono_2) as _.\n  exact eq_refl.\n}\ndestruct_sigma (@MonoIntro_rule A C g_f Hpremise1) as isMono_5.\nexact isMono_5.\nQed.\n",
