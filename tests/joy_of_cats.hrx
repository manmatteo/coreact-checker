      "rocqProof": "Lemma Prop_7_54__1_4___the_identity_equalizes_equal_arrows_rule : forall (A B : Vertex)(idA : Edge A A)(f g : Edge A B)(eq_f_g : f = g), ltac:(subst_all_in (forall (isId_2 : isId idA), Equalizer idA f g)).\nintros_sigma ().\nassert (Hpremise1 : Σ (x_f__e : Edge A B)(Triangle_2 : Triangle idA f x_f__e), Triangle idA g x_f__e). {\n  intros_sigma ().\n  destruct_sigma (@UnitL_rule A B idA f isId_2) as Triangle_4.\n  exact (f, Triangle_4, Triangle_4).\n}\nassert (Hpremise2 : forall (X : Vertex)(x : Edge X A)(w : Edge X B)(Triangle_2 : Triangle x f w)(Triangle_3 : Triangle x g w), Σ (x_x__e : Edge X A), Triangle x_x__e idA x). {\n  intros_sigma ().\n  destruct_sigma (@UnitR_rule X A x idA isId_2) as Triangle_5.\n  exact (x, Triangle_5).\n}\nassert (Hpremise3 : forall (X : Vertex)(u v x : Edge X A)(Triangle_2 : Triangle u idA x)(Triangle_3 : Triangle v idA x), u = v). {\n  intros_sigma ().\n  destruct_sigma (@UnitR_rule X A u idA isId_2) as Triangle_4.\n  destruct_sigma (@UnitR_rule X A v idA isId_2) as Triangle_5.\n  destruct_sigma (@ComposeUnique_rule X A A u idA x u Triangle_2 Triangle_4) as _.\n  destruct_sigma (@ComposeUnique_rule X A A v idA u v Triangle_3 Triangle_5) as _.\n  exact eq_refl.\n}\ndestruct_sigma (@EqualizerIntro_rule A A B idA f g Hpremise1 Hpremise2 Hpremise3) as Equalizer_3.\nexact Equalizer_3.\nQed.\n",
