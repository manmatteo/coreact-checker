      "rocqProof": "Lemma Prop_11_10_1___pullback_squares_paste_rule : forall (A B C D E F : Vertex)(f : Edge A B)(g : Edge B C)(f' : Edge D E)(g' : Edge E F)(a : Edge A D)(b : Edge B E)(c : Edge C F)(gf : Edge A C)(g'f' : Edge D F)(Triangle_2 : Triangle f g gf)(Triangle_3 : Triangle f' g' g'f')(Pullback_2 : Pullback f a f' b)(Pullback_3 : Pullback g b g' c), Pullback gf a g'f' c.\nintros_sigma ().\nassert (Hpremise1 : Σ (x_f__p : Edge A F)(Triangle_4 : Triangle gf c x_f__p), Triangle a g'f' x_f__p). {\n  intros_sigma ().\n  destruct_sigma (@PullbackCommute_rule A B D E f a b f' Pullback_2) as b_f Triangle_6 Triangle_7.\n  destruct_sigma (@PullbackCommute_rule B C E F g b c g' Pullback_3) as c_g Triangle_8 Triangle_9.\n  destruct_sigma (@Compose_rule A B F f c_g) as c_g_f Triangle_10.\n  destruct_sigma (@AssocR_rule A B C F f g c gf c_g c_g_f Triangle_2 Triangle_8 Triangle_10) as Triangle_11.\n  destruct_sigma (@AssocR_rule A B E F f b g' b_f c_g c_g_f Triangle_6 Triangle_9 Triangle_10) as Triangle_12.\n  destruct_sigma (@AssocL_rule A D E F a f' g' b_f g'f' c_g_f Triangle_7 Triangle_3 Triangle_12) as Triangle_13.\n  exact (c_g_f, Triangle_11, Triangle_13).\n}\nassert (Hpremise2 : forall (X : Vertex)(x : Edge X C)(y : Edge X D)(w : Edge X F)(Triangle_4 : Triangle x c w)(Triangle_5 : Triangle y g'f' w), Σ (x__x__y_ : Edge X A)(Triangle_6 : Triangle x__x__y_ gf x), Triangle x__x__y_ a y). {\n  intros_sigma ().\n  destruct_sigma (@Compose_rule X D E y f') as f'_y Triangle_8.\n  destruct_sigma (@AssocR_rule X D E F y f' g' f'_y g'f' w Triangle_8 Triangle_3 Triangle_5) as Triangle_9.\n  destruct_sigma (@PullbackExists_rule B C E F X g b c g' x f'_y w Triangle_4 Triangle_9 Pullback_3) as x_x_f'_y_ Triangle_10 Triangle_11.\n  destruct_sigma (@PullbackExists_rule A B D E X f a b f' x_x_f'_y_ y f'_y Triangle_11 Triangle_8 Pullback_2) as x__x_f'_y__y_ Triangle_12 Triangle_13.\n  destruct_sigma (@AssocL_rule X A B C x__x_f'_y__y_ f g x_x_f'_y_ gf x Triangle_12 Triangle_2 Triangle_10) as Triangle_14.\n  exact (x__x_f'_y__y_, Triangle_14, Triangle_13).\n}\nassert (Hpremise3 : forall (X : Vertex)(x : Edge X C)(y : Edge X D)(u v : Edge X A)(Triangle_4 : Triangle u gf x)(Triangle_5 : Triangle u a y)(Triangle_6 : Triangle v gf x)(Triangle_7 : Triangle v a y), u = v). {\n  intros_sigma ().\n  destruct_sigma (@Compose_rule X A B u f) as f_u Triangle_8.\n  destruct_sigma (@Compose_rule X A B v f) as f_v Triangle_9.\n  destruct_sigma (@Compose_rule X D E y f') as f'_y Triangle_10.\n  destruct_sigma (@AssocR_rule X A B C u f g f_u gf x Triangle_8 Triangle_2 Triangle_4) as Triangle_11.\n  destruct_sigma (@AssocR_rule X A B C v f g f_v gf x Triangle_9 Triangle_2 Triangle_6) as Triangle_12.\n  destruct_sigma (@PullbackCommute_rule A B D E f a b f' Pullback_2) as b_f Triangle_13 Triangle_14.\n  destruct_sigma (@AssocL_rule X A D E u a f' y b_f f'_y Triangle_5 Triangle_14 Triangle_10) as Triangle_15.\n  destruct_sigma (@AssocL_rule X A D E v a f' y b_f f'_y Triangle_7 Triangle_14 Triangle_10) as Triangle_16.\n  destruct_sigma (@AssocR_rule X A B E u f b f_u b_f f'_y Triangle_8 Triangle_13 Triangle_15) as Triangle_17.\n  destruct_sigma (@AssocR_rule X A B E v f b f_v b_f f'_y Triangle_9 Triangle_13 Triangle_16) as Triangle_18.\n  destruct_sigma (@PullbackUnique_rule B C E F X g b c g' x f'_y f_u f_v Triangle_11 Triangle_17 Triangle_12 Triangle_18 Pullback_3) as _.\n  destruct_sigma (@PullbackUnique_rule A B D E X f a b f' f_u y u v Triangle_8 Triangle_5 Triangle_9 Triangle_7 Pullback_2) as _.\n  exact eq_refl.\n}\ndestruct_sigma (@PullbackIntro_rule A C D F gf a c g'f' Hpremise1 Hpremise2 Hpremise3) as Pullback_5.\nexact Pullback_5.\nQed.\n",
      "proved": false
