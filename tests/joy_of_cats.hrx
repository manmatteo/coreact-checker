      "rocqProof": "Lemma Prop_3_10__left_and_right_inverse_agree_rule : forall (A B : Vertex)(f : Edge A B)(g h : Edge B A)(idA : Edge A A)(idB : Edge B B)(Triangle_2 : Triangle f g idA)(Triangle_3 : Triangle h f idB)(isId_2 : isId idA)(isId_3 : isId idB), g = h.\nintros_sigma ().\ndestruct_sigma (@UnitL_rule B A idB g isId_3) as Triangle_4.\ndestruct_sigma (@UnitR_rule B A h idA isId_2) as Triangle_5.\ndestruct_sigma (@AssocL_rule B A B A h f g idB idA g Triangle_3 Triangle_2 Triangle_4) as Triangle_6.\ndestruct_sigma (@ComposeUnique_rule B A A h idA g h Triangle_6 Triangle_5) as _.\nexact eq_refl.\nQed.\n",
