//!Require joy
return api.joy.edgeBadge(context, data.arrow, 0.25, false, "section");
<===> sorts/isRetraction.js
//!Require joy
return api.joy.edgeBadge(context, data.arrow, 0.75, false, "retraction");
<===> sorts/isIso.js
//!Require joy
return api.joy.edgeBadge(context, data.arrow, 0.3, false, "≅");
<===> sorts/isInitial.js
//!Require joy
const { R, badge } = api.joy;
return badge(context, [data.object.position[0], data.object.position[1] + R + 14], "initial");
<===> sorts/Equalizer.js
//!Require joy
return api.joy.edgeBadge(context, data.e, 0.5, true, "eq(" + (data.f.label || "f") + ", " + (data.g.label || "g") + ")");
<===> sorts/Product.js
//!Require joy
const { unit, badge } = api.joy;
const v = data.p1.source.position;
const w = unit(
    (data.p1.target.position[0] + data.p2.target.position[0]) / 2 - v[0],
    (data.p1.target.position[1] + data.p2.target.position[1]) / 2 - v[1]);
return badge(context, [v[0] + w[0] * 40, v[1] + w[1] * 40], "×");
<===> sorts/Pullback.js
//!Require joy
// p1, p2 are the projections, with p1 ; q2 = p2 ; q1.
const { corner } = api.joy;
return corner(context, data.p1.source.position, data.p1.target.position, data.p2.target.position);
<===> js/joy.js
    // Drawing helpers of the Joy of Cats sorts (api.joy). Indented, so that the workbench does
    // not hoist the constants out of this module.
    const R = 20;
    const INK = "#555";

    const unit = (x, y) => {
        const l = Math.hypot(x, y);
        return l > 0 ? [x / l, y / l] : [1, 0];
    };

    // Cubic Bezier control points of an edge, clipped to the vertex circles.
    function curve(edge) {
        const s = edge.source.position, t = edge.target.position;
        const bend = typeof edge.bend === "number" ? edge.bend : 0;
        if (s[0] === t[0] && s[1] === t[1]) {
            const th = (bend - 90) * Math.PI / 180, spread = 0.6, reach = 85;
            const at = (a, r) => [s[0] + r * Math.cos(a), s[1] + r * Math.sin(a)];
            return [at(th - spread, R), at(th - spread, reach), at(th + spread, reach), at(th + spread, R)];
        }
        const [dx, dy] = [t[0] - s[0], t[1] - s[1]];
        const [ux, uy] = unit(dx, dy);
        const c = [(s[0] + t[0]) / 2 - uy * bend, (s[1] + t[1]) / 2 + ux * bend];
        const [ax, ay] = unit(c[0] - s[0], c[1] - s[1]);
        const [bx, by] = unit(t[0] - c[0], t[1] - c[1]);
        const p0 = [s[0] + ax * R, s[1] + ay * R], p3 = [t[0] - bx * R, t[1] - by * R];
        const toward = p => [p[0] + 2 / 3 * (c[0] - p[0]), p[1] + 2 / 3 * (c[1] - p[1])];
        return [p0, toward(p0), toward(p3), p3];
    }

    function pointAt([p0, p1, p2, p3], t) {
        const s = 1 - t;
        return [0, 1].map(i =>
            s * s * s * p0[i] + 3 * s * s * t * p1[i] + 3 * s * t * t * p2[i] + t * t * t * p3[i]);
    }

    function tangentAt([p0, p1, p2, p3], t) {
        const s = 1 - t;
        const d = [0, 1].map(i =>
            s * s * (p1[i] - p0[i]) + 2 * s * t * (p2[i] - p1[i]) + t * t * (p3[i] - p2[i]));
        return unit(d[0], d[1]);
    }

    const midpoint = edge => pointAt(curve(edge), 0.5);

    function arrowHead(group, tip, [ux, uy], size) {
        const [bx, by] = [tip[0] - ux * size, tip[1] - uy * size];
        const w = size * 0.45;
        group.append("path")
            .attr("d", `M ${bx - uy * w},${by + ux * w} L ${tip[0]},${tip[1]} L ${bx + uy * w},${by - ux * w}`)
            .attr("fill", "none").attr("stroke", INK).attr("stroke-width", 2);
    }

    // A small framed caption; the frame is a path, so it takes the colour of its layer.
    function badge(context, [x, y], text) {
        const group = context.append("g");
        const w = 8 + 6.4 * text.length, h = 16;
        group.append("path")
            .attr("d", `M ${x - w / 2},${y - h / 2} h ${w} v ${h} h ${-w} Z`)
            .attr("fill", "white").attr("stroke", INK).attr("stroke-width", 1.2);
        group.append("text").attr("x", x).attr("y", y + 4).attr("text-anchor", "middle")
            .attr("fill", "#333").attr("font-family", "sans-serif").attr("font-size", "11px").text(text);
        return group;
    }

    // Badge on an edge at parameter t: on the line, or beside it, opposite to the edge's label
    // (for a loop: outside, past the label).
    function edgeBadge(context, edge, t, beside, text) {
        const c = curve(edge), p = pointAt(c, t), [ux, uy] = tangentAt(c, t);
        if (!beside) return badge(context, p, text);
        const loop = edge.source.position[0] === edge.target.position[0] && edge.source.position[1] === edge.target.position[1];
        const off = 6 + Math.abs(uy) * (4 + 3.2 * text.length) + Math.abs(ux) * 8;
        const side = loop ? -(off + 20) : off;
        return badge(context, [p[0] - uy * side, p[1] + ux * side], text);
    }

    // Right-angle corner at a vertex v, opening towards the vertices a and b.
    function corner(context, v, a, b) {
        const u = unit(a[0] - v[0], a[1] - v[1]), w = unit(b[0] - v[0], b[1] - v[1]);
        const at = (m, n) => `${v[0] + u[0] * m + w[0] * n},${v[1] + u[1] * m + w[1] * n}`;
        const group = context.append("g");
        group.append("path").attr("d", `M ${at(26, 42)} L ${at(42, 42)} L ${at(42, 26)}`)
            .attr("fill", "none").attr("stroke", "#333").attr("stroke-width", 2);
        return group;
    }

    return { R, INK, unit, curve, pointAt, tangentAt, midpoint, arrowHead, badge, edgeBadge, corner };
