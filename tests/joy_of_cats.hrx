<===> sorts/Vertex.js
//!Require joy
// Vertex = object of the category.
const { R } = api.joy;
const group = context.append("g").attr("transform", `translate(${data.position[0]}, ${data.position[1]})`);
group.append("circle").attr("r", R).attr("fill", "#69b3a2").attr("stroke", "#333").attr("stroke-width", 2);
if (data.label) {
    group.append("text").attr("text-anchor", "middle").attr("dy", ".3em").attr("fill", "white")
        .attr("font-family", "sans-serif").attr("font-size", "14px").text(data.label);
}
return group;
<===> sorts/Edge.js
//!Require joy
// Edge = morphism. A loop when source = target: its bend is then the angle at which it leaves the vertex.
const { INK, curve, pointAt, tangentAt, arrowHead } = api.joy;
const c = curve(data);
const group = context.insert("g", ":first-child");
const line = group.append("path")
    .attr("d", `M ${c[0]} C ${c[1]} ${c[2]} ${c[3]}`)
    .attr("fill", "none").attr("stroke", INK).attr("stroke-width", data.width);
if (data.isId) {
    // Identities: thick line with a white core, i.e. a double line.
    line.attr("stroke-width", 6);
    group.append("path").attr("d", `M ${c[0]} C ${c[1]} ${c[2]} ${c[3]}`)
        .attr("fill", "none").style("stroke", "white").attr("stroke-width", 2.5);
} else {
    arrowHead(group, c[3], tangentAt(c, 1), 11);
}
if (data.label) {
    const m = pointAt(c, 0.5), [ux, uy] = tangentAt(c, 0.5);
    // Label on the left of the arrow, or outside of a loop.
    context.append("text")
        .attr("x", m[0] + uy * 14).attr("y", m[1] - ux * 14 + 4)
        .attr("text-anchor", "middle").attr("fill", "#222")
        .attr("font-family", "sans-serif").attr("font-size", "13px").text(data.label);
}
return group;
<===> sorts/Triangle.js
//!Require joy
// Triangle(1 = f, 2 = g, o = h) = "h is g∘f": a 2-cell from the middle vertex of the composite
// to the middle of the edge "o".
const { R, unit, midpoint } = api.joy;
const a = data["1"].target.position, m = midpoint(data.o);
const bend = typeof data.bend === "number" ? data.bend : 0;
const group = context.append("g");
if (Math.hypot(m[0] - a[0], m[1] - a[1]) < R + 45) return group;
const [ux, uy] = unit(m[0] - a[0], m[1] - a[1]);
const ctrl = [(a[0] + m[0]) / 2 - uy * bend, (a[1] + m[1]) / 2 + ux * bend];
const s = unit(ctrl[0] - a[0], ctrl[1] - a[1]), e = unit(m[0] - ctrl[0], m[1] - ctrl[1]);
// Stop short of the edge, which leaves room for its label.
const from = [a[0] + s[0] * (R + 4), a[1] + s[1] * (R + 4)], to = [m[0] - e[0] * 24, m[1] - e[1] * 24];
for (const k of [-3, 3]) {
    const sh = ([x, y]) => `${x - uy * k},${y + ux * k}`;
    group.append("path").attr("d", `M ${sh(from)} Q ${sh(ctrl)} ${sh([to[0] - e[0] * 5, to[1] - e[1] * 5])}`)
        .attr("fill", "none").attr("stroke", "#8e44ad").attr("stroke-width", 1.4);
}
const [bx, by] = [to[0] - e[0] * 9, to[1] - e[1] * 9];
group.append("path")
    .attr("d", `M ${bx - e[1] * 7},${by + e[0] * 7} L ${to} L ${bx + e[1] * 7},${by - e[0] * 7}`)
    .attr("fill", "none").attr("stroke", "#8e44ad").attr("stroke-width", 1.4);
return group;
<===> sorts/isId.js
// Drawn by its edge (a double line).
return context.append("g");
<===> sorts/isMono.js
//!Require joy
// Hook at the tail.
const { INK, curve, tangentAt } = api.joy;
const c = curve(data.arrow), p = c[0], [ux, uy] = tangentAt(c, 0);
const group = context.append("g");
group.append("path")
    .attr("d", `M ${p[0] + ux * 6},${p[1] + uy * 6} A 5 5 0 0 1 ${p[0] + ux * 6 + uy * 10},${p[1] + uy * 6 - ux * 10}`)
    .attr("fill", "none").attr("stroke", INK).attr("stroke-width", 2);
return group;
<===> sorts/isEpi.js
//!Require joy
// Second arrow head.
const { curve, tangentAt, arrowHead } = api.joy;
const c = curve(data.arrow), [ux, uy] = tangentAt(c, 1);
const group = context.append("g");
arrowHead(group, [c[3][0] - ux * 8, c[3][1] - uy * 8], [ux, uy], 11);
return group;
