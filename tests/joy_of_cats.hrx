      "rocqProof": "Lemma Prop_11_11__pullbacks_from_products_and_equalizers_rule : forall (E P A B C : Vertex)(pA : Edge P A)(pB : Edge P B)(f : Edge A C)(g : Edge B C)(f_pA g_pB : Edge P C)(e : Edge E P)(pA_e : Edge E A)(pB_e : Edge E B)(Triangle_2 : Triangle pA f f_pA)(Triangle_3 : Triangle pB g g_pB)(Triangle_4 : Triangle e pA pA_e)(Triangle_5 : Triangle e pB pB_e)(Equalizer_2 : Equalizer e f_pA g_pB)(Product_2 : Product pA pB), Pullback pA_e pB_e g f.\nintros_sigma ().\nassert (Hpremise1 : Σ (x_f__p : Edge E C)(Triangle_6 : Triangle pA_e f x_f__p), Triangle pB_e g x_f__p). {\n  intros_sigma ().\n  destruct_sigma (@EqualizerFork_rule E P C e f_pA g_pB Equalizer_2) as f_pA_e Triangle_8 Triangle_9.\n  destruct_sigma (@AssocR_rule E P A C e pA f pA_e f_pA f_pA_e Triangle_4 Triangle_2 Triangle_8) as Triangle_10.\n  destruct_sigma (@AssocR_rule E P B C e pB g pB_e g_pB f_pA_e Triangle_5 Triangle_3 Triangle_9) as Triangle_11.\n  exact (f_pA_e, Triangle_10, Triangle_11).\n}\nassert (Hpremise2 : forall (X : Vertex)(x : Edge X A)(y : Edge X B)(w : Edge X C)(Triangle_6 : Triangle x f w)(Triangle_7 : Triangle y g w), Σ (x__x__y_ : Edge X E)(Triangle_8 : Triangle x__x__y_ pA_e x), Triangle x__x__y_ pB_e y). {\n  intros_sigma ().\n  destruct_sigma (@ProductExists_rule P A B X pA pB x y Product_2) as x_x_y_ Triangle_10 Triangle_11.\n  destruct_sigma (@AssocL_rule X P A C x_x_y_ pA f x f_pA w Triangle_10 Triangle_2 Triangle_6) as Triangle_12.\n  destruct_sigma (@AssocL_rule X P B C x_x_y_ pB g y g_pB w Triangle_11 Triangle_3 Triangle_7) as Triangle_13.\n  destruct_sigma (@EqualizerExists_rule E P C X e f_pA g_pB x_x_y_ w Triangle_12 Triangle_13 Equalizer_2) as x_x_y__e Triangle_14.\n  destruct_sigma (@AssocL_rule X E P A x_x_y__e e pA x_x_y_ pA_e x Triangle_14 Triangle_4 Triangle_10) as Triangle_15.\n  destruct_sigma (@AssocL_rule X E P B x_x_y__e e pB x_x_y_ pB_e y Triangle_14 Triangle_5 Triangle_11) as Triangle_16.\n  exact (x_x_y__e, Triangle_15, Triangle_16).\n}\nassert (Hpremise3 : forall (X : Vertex)(x : Edge X A)(y : Edge X B)(u v : Edge X E)(Triangle_6 : Triangle u pA_e x)(Triangle_7 : Triangle u pB_e y)(Triangle_8 : Triangle v pA_e x)(Triangle_9 : Triangle v pB_e y), u = v). {\n  intros_sigma ().\n  destruct_sigma (@Compose_rule X E P u e) as e_u Triangle_10.\n  destruct_sigma (@Compose_rule X E P v e) as e_v Triangle_11.\n  destruct_sigma (@AssocR_rule X E P A u e pA e_u pA_e x Triangle_10 Triangle_4 Triangle_6) as Triangle_12.\n  destruct_sigma (@AssocR_rule X E P B u e pB e_u pB_e y Triangle_10 Triangle_5 Triangle_7) as Triangle_13.\n  destruct_sigma (@AssocR_rule X E P A v e pA e_v pA_e x Triangle_11 Triangle_4 Triangle_8) as Triangle_14.\n  destruct_sigma (@AssocR_rule X E P B v e pB e_v pB_e y Triangle_11 Triangle_5 Triangle_9) as Triangle_15.\n  destruct_sigma (@ProductUnique_rule P A B X pA pB x y e_u e_v Triangle_12 Triangle_13 Triangle_14 Triangle_15 Product_2) as _.\n  destruct_sigma (@EqualizerUnique_rule E P C X e f_pA g_pB u v e_u Triangle_10 Triangle_11 Equalizer_2) as _.\n  exact eq_refl.\n}\ndestruct_sigma (@PullbackIntro_rule E A B C pA_e pB_e f g Hpremise1 Hpremise2 Hpremise3) as Pullback_3.\nexact Pullback_3.\nQed.\n",
