% Statements and proofs that every backend must accept or reject.
accumulate cat.
macro @v :- s "Vertex" [].
macro @e A B :- s "Edge" [A,B].
macro @t F G H :- s "Triangle" [F,G,H].
macro @m F :- s "isMono" [F].
type comp, addmono, n1 name.

pred base o:list item.
base [
 axiom comp (all @v a\ all @v b\ all @v c\ all (@e a b) f\ all (@e b c) g\ ex (@e a c) h\ ex (@t f g h) _\ tt),
 def addmono (all @v a\ all @v b\ all (@e a b) m\
   imp (all @v x\ all (@e x a) f\ all (@e x a) g\ all (@e x b) u\
        all (@t f m u) _\ all (@t g m u) _\ ex (eq f g) _\ tt) (ex (@m m) _\ tt))].

pred accepted i:eq_ctx, i:fm, i:pf.
accepted E F P :- base B, std.append B [thm n1 F P] L, script E L.
pred good i:eq_ctx, i:string, i:fm, i:pf.
good E S F P :- (accepted E F P, !, print "ok: accepted" S ; print "WRONG: rejected" S, fail).
pred bad i:eq_ctx, i:string, i:fm, i:pf.
bad E S F P :- (accepted E F P, !, print "WRONG: accepted" S, fail ; print "ok: rejected" S).
pred second i:eq_ctx, i:string, i:fm, i:pf.         % accepted only with -D SECOND
:if "SECOND" second E S F P :- good E S F P, !.
:if "SECOND" second _ _ _ _ :- !, fail.
second E S F P :- bad E S F P.

main :- std.forall ["cut", "part"] (b\ sigma E\ backend b E, print "backend" b, tests E).

pred tests i:eq_ctx.
tests E :-
 good E "generated elimination rule" 
   (all @v a\ all @v b\ all (@e a b) m\ all @v x\ all (@e x a) f\ all (@e x a) g\ all (@e x b) u\ all (@m m) _\ all (@t f m u) _\ all (@t g m u) _\ ex (eq f g) _\ tt)
   (intro a\ intro b\ intro m\ intro x\ intro f\ intro g\ intro u\ intro q\ intro t1\ intro t2\ apply (inv addmono 0) [a,b,m,q,x,f,g,u,t1,t2] [] (unpack _\ done [refl])),
 bad E "proof arguments left as holes" 
   (all @v a\ all @v b\ all (@e a b) m\ all @v x\ all (@e x a) f\ all (@e x a) g\ all (@e x b) u\ all (@m m) _\ all (@t f m u) _\ all (@t g m u) _\ ex (eq f g) _\ tt)
   (intro a\ intro b\ intro m\ intro x\ intro f\ intro g\ intro u\ intro q\ intro t1\ intro t2\ apply (inv addmono 0) [_,_,m,_,_,f,g,_,_,_] [] (unpack _\ done [refl])),
 bad E "no isMono hypothesis"
   (all @v a\ all @v b\ all (@e a b) m\ all @v x\ all (@e x a) f\ all (@e x a) g\ all (@e x b) u\ all (@t f m u) _\ all (@t g m u) _\ ex (eq f g) _\ tt)
   (intro a\ intro b\ intro m\ intro x\ intro f\ intro g\ intro u\ intro t1\ intro t2\ apply (inv addmono 0) [a,b,m,t1,x,f,g,u,t1,t2] [] (unpack _\ done [refl])),
 bad E "all parallel arrows equal" (all @v a\ all @v b\ all (@e a b) f\ all (@e a b) g\ ex (eq f g) _\ tt) (intro _\ intro _\ intro _\ intro _\ done [refl]),
 bad E "wrong composability" (all @v a\ all @v b\ all (@e a b) f\ ex (@e a a) _\ tt) (intro a\ intro b\ intro f\ apply comp [a,b,a,f,f] [] (unpack h\ unpack _\ done [h])),
 bad E "witness of wrong type" (all @v a\ all @v b\ all (@e a b) f\ ex (@e b a) _\ tt) (intro a\ intro b\ intro f\ done [f]),
 bad E "hole as witness" (all @v a\ all @v b\ all (@e a b) f\ ex (@e b a) _\ tt) (intro a\ intro b\ intro f\ done [_]),
 bad E "ill-formed: vertex = edge" (all @v a\ all (@e a a) f\ all (eq a f) _\ tt) (intro a\ intro f\ intro _\ done []),
 bad E "ill-formed: equality across types" (all @v a\ all @v b\ all (@e a b) f\ all (@e b a) g\ all (eq f g) _\ tt) (intro a\ intro b\ intro f\ intro g\ intro _\ done []),
 good E "transport along equalities" (all @v a\ all @v b\ all @v c\ all (@e a b) f\ all (eq a c) _\ all (eq c b) _\ ex (@e b a) _\ tt) (intro a\ intro b\ intro c\ intro f\ intro _\ intro _\ done [f]),
 bad E "dropped premise" (all @v a\ all @v b\ all (@e a b) m\ ex (@m m) _\ tt) (intro a\ intro b\ intro m\ apply addmono [a,b,m] [] (unpack r\ done [r])),
 second E "second-order theorem"
   (all @v a\ all @v b\ all (@e a b) m\ imp (all @v x\ all (@e x a) f\ all (@e x a) g\ all (@e x b) u\
        all (@t f m u) _\ all (@t g m u) _\ ex (eq f g) _\ tt) (ex (@m m) _\ tt))
   (intro a\ intro b\ intro m\ intro_rule n\ apply addmono [a,b,m] [intro x\ intro f\ intro g\ intro u\ intro t1\ intro t2\ apply n [x,f,g,u,t1,t2] [] (unpack _\ done [refl])] (unpack r\ done [r])).
